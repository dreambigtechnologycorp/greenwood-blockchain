{
  "chainId": "{{ provider_chain_id | default('greenwood-physical-v1') }}",
  "rpcEndpoint": {{ provider_rpc_endpoint | to_json }},
  "keyFile": "/etc/greenwood/provider.key",
  "dataPath": "{{ provider_data_dir }}",
  "workerUid": {{ worker_uid }},
  "workerGid": {{ worker_gid }},
  "containerdSocket": "/run/containerd/containerd.sock",
  "snapshotter": "{% if greenwood_os_family == 'Debian' %}{{ containerd_snapshotter }}{% else %}erofs{% endif %}",
  "trustClasses": [0],
  "maxConcurrent": {{ [(provider_max_concurrent | int), (greenwood_processor_vcpus | int)] | min }},
  "maxCpuMillis": {{ (greenwood_processor_vcpus | int * 1000 * (provider_cpu_fraction | float)) | round | int }},
  "maxMemoryBytes": {{ (greenwood_memtotal_mb | int * 1024 * 1024 * (provider_memory_fraction | float)) | round | int }},
  "maxPids": 256,
  "maxTimeoutMs": 3600000,
  "maxOutputBytes": 1048576,
  "controlTimeoutMs": 120000,
  "pollIntervalMs": 1000
}